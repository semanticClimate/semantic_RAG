FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production

REDIS_URL=redis://localhost:6379/0

CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=climate_academy

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1000
BEDROCK_TEMPERATURE=0.3

CHUNK_SIZE=150
CHUNK_OVERLAP=30
CHUNK_MODE=default
SOURCE_HTML_PATH=input/climate_academy.html
SOURCE_HTML_PATHS=input/climate_academy.html,input/climate_filtered.html

TOP_K=5
DISTANCE_THRESHOLD=0.7

SESSION_TTL_SECONDS=86400

LOG_LEVEL=INFO   # DEBUG for development, INFO for production

GUNICORN_WORKERS=4
LOG_DIR=/var/log/climate-rag
